;;
;; Get methods of a Contract Verifier
;;

_ %verify(slice $piA, slice $piB, slice $piC, cell $pubInputs) method_id(71203) {
    slice $piA = $piA;
    slice $piB = $piB;
    slice $piC = $piC;
    cell $pubInputs = $pubInputs;
    var self = $Verifier$_contract_load();
    var res = self~$Verifier$_fun_verify($piA, $piB, $piC, $pubInputs);
    return res;
}

;;
;; Routing of a Contract Verifier
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var $self = $Verifier$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive Verify message
    if (op == 0x3b3cca17) {
        var $msg'piA = in_msg~load_ref();
        var $msg'piB = in_msg~load_ref();
        slice sc_1 = in_msg~load_ref().begin_parse();
        var $msg'piC = sc_1~load_ref();
        var $msg'pubInputs = sc_1~load_dict();
        throw_unless(261, ($Context$_get_value(__tact_context_get()) >= 50000000));
        int $res = $self~$Verifier$_fun_groth16Verify($global_loadCheckedG1($msg'piA), $global_loadCheckedG2($msg'piB), $global_loadCheckedG1($msg'piC), $msg'pubInputs);
        throw_unless(260, $res);
        $Verifier$_contract_store($self);
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $Verifier$_contract_store($self);
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
