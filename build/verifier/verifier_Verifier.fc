() $global_assertNoExtraPubInputs(cell $pubInputs) impure inline_ref {
    var ($key, $fresh$underscore_1, $fresh$flag_0) = __tact_dict_min_uint_int($pubInputs, 32, 257);
    while ($fresh$flag_0) {
