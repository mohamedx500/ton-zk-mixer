# ==============================================================================
# TON ZK-MIXER PROTOCOL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK SETTINGS ('mainnet' or 'testnet')
# ------------------------------------------------------------------------------
# Change to 'mainnet' when running on TON Mainnet
TON_NETWORK=testnet

# TON HTTP RPC Endpoint:
# Mainnet: https://toncenter.com/api/v2/jsonRPC
# Testnet: https://testnet.toncenter.com/api/v2/jsonRPC
TON_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC

# TonCenter API Key (Recommended for Mainnet to unlock 10 req/sec instead of 1 req/sec)
# Get a free key from Telegram bot: @tonapibot
TONCENTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. SMART CONTRACT ADDRESSES
# ------------------------------------------------------------------------------
# Active TonZkMixer contract address
# Testnet deployed address: 0QAz-Jy7XX5pMi925pFFHGzTgKRqirwK7CgtZMT5mGAhknET
# For Mainnet: populate after running "npm run deploy:mainnet"
MIXER_CONTRACT_ADDRESS=0QAz-Jy7XX5pMi925pFFHGzTgKRqirwK7CgtZMT5mGAhknET

# ------------------------------------------------------------------------------
# 3. WALLET CREDENTIALS (MAINNET / TESTNET)
# ------------------------------------------------------------------------------
# 24-word seed phrase for contract deployer & admin functions
# Example: "word1 word2 word3 ... word24"
DEPLOYER_MNEMONIC=

# 24-word seed phrase for the Gasless Relayer Network wallet
# Must be funded with TON to cover user withdrawal gas fees on-chain.
# Leave empty to generate a fresh wallet automatically.
RELAYER_MNEMONIC=

# ------------------------------------------------------------------------------
# 4. GASLESS RELAYER NETWORK SETTINGS
# ------------------------------------------------------------------------------
RELAYER_PORT=4000

# Gas attached by Relayer for BLS12-381 TVM pairing verification & payout (in nanoton)
# 0.04 TON = 40000000 nanoton
RELAYER_GAS_FEE=40000000

# ------------------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS) CLIENT CONFIGURATION
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TON_NETWORK=testnet
NEXT_PUBLIC_MIXER_ADDRESS=0QAz-Jy7XX5pMi925pFFHGzTgKRqirwK7CgtZMT5mGAhknET
NEXT_PUBLIC_TON_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
NEXT_PUBLIC_TONCENTER_API_KEY=
NEXT_PUBLIC_RELAYER_URL=http://localhost:4000/relay
