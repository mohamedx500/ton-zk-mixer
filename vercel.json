{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "relayer",
          "format": "url",
          "env": "RELAYER_SERVICE_URL"
        }
      ]
    },
    "relayer": {
      "root": "relayer",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
